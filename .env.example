# Postgres (Dokploy provisiona e injeta a URL real em produção)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/craft_tarefas?schema=public"

# gerar com: openssl rand -hex 32
JWT_SECRET="troque-por-um-valor-aleatorio"

# senha inicial do admin — só é usada na primeira vez que o servidor sobe
# (cria o registro de Config). Depois disso, a senha real fica no banco
# e pode ser trocada pelo próprio painel admin.
ADMIN_INITIAL_PASSWORD="troque-esta-senha"

PORT=3000
NODE_ENV=development
